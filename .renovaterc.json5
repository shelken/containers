{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor",
    "github>shelken/containers//.renovate/autoMerge.json5",
    "github>shelken/containers//.renovate/labels.json5",
    "github>shelken/containers//.renovate/semanticCommits.json5",
    ":automergeBranch",
    ":dependencyDashboard",
    ":timezone(Asia/Shanghai)",
  ],
  prConcurrentLimit: 1,
  rebaseWhen: "conflicted",
  customManagers: [
    {
      customType: "regex",
      description: "Process Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = \"(?<currentValue>[^\"]+)\"",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Annotations in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  // bumpVersions 放在 packageRules 里按应用拆分: 全局配置会在分支内任意文件更新时 bump 所有匹配文件
  packageRules: [
    {
      // Dockerfile 里的 ARG GO_VERSION 只是 fallback, 实际版本由 docker-bake.hcl 提供并由注解跟踪
      description: "Ignore golang fallback in Dockerfile; docker-bake.hcl is the source of truth",
      matchManagers: ["dockerfile"],
      matchPackageNames: ["golang"],
      enabled: false,
    },
    {
      description: "Bump alertmanager-wechatrobot patch version when its own dependencies update",
      matchFileNames: ["apps/alertmanager-wechatrobot/**"],
      bumpVersions: [
        {
          filePatterns: ["apps/alertmanager-wechatrobot/docker-bake.hcl"],
          matchStrings: [
            'variable "VERSION"\\s*\\{\\s*\\n\\s*default\\s*=\\s*"(?<version>[^"]+)"',
          ],
          bumpType: "patch",
        },
      ],
    },
    {
      description: "Bump simple-hello-world patch version when its own dependencies update",
      matchFileNames: ["apps/simple-hello-world/**"],
      bumpVersions: [
        {
          filePatterns: ["apps/simple-hello-world/docker-bake.hcl"],
          matchStrings: [
            'variable "VERSION"\\s*\\{\\s*\\n\\s*default\\s*=\\s*"(?<version>[^"]+)"',
          ],
          bumpType: "patch",
        },
      ],
    },
    {
      description: "Bump subconverter patch version when its own dependencies update",
      matchFileNames: ["apps/subconverter/**"],
      bumpVersions: [
        {
          filePatterns: ["apps/subconverter/docker-bake.hcl"],
          matchStrings: [
            'variable "VERSION"\\s*\\{\\s*\\n\\s*default\\s*=\\s*"(?<version>[^"]+)"',
          ],
          bumpType: "patch",
        },
      ],
    },
    {
      description: "Bump zte-mifi-exporter patch version when its own dependencies update",
      matchFileNames: ["apps/zte-mifi-exporter/**"],
      bumpVersions: [
        {
          filePatterns: ["apps/zte-mifi-exporter/docker-bake.hcl"],
          matchStrings: [
            'variable "VERSION"\\s*\\{\\s*\\n\\s*default\\s*=\\s*"(?<version>[^"]+)"',
          ],
          bumpType: "patch",
        },
      ],
    },
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  schedule: ["every weekend"],
}
